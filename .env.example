MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=attendex
PORT=8000
# Production: set the exact public HTTPS origin and secure cookies.
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=0
NODE_ENV=development
# Set only behind one trusted reverse proxy. Leave 0 for direct access.
TRUST_PROXY=0

# Optional experimental biometrics: 32 random bytes encoded as 64 hex characters.
# Keep this key stable and secret. Losing it makes saved templates unreadable.
BIOMETRIC_KEY=

# Release controls. Pilot is the default; production activation is fail-closed.
DEPLOYMENT_MODE=pilot
REQUIRE_TEACHER_APPROVAL=0
# Comma-separated exact account emails. Administrators must verify their email.
ADMIN_EMAILS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Managed AWS face/liveness integration is OFF until the operator configures it.
AWS_FACE_ENABLED=0
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
LIVENESS_ROLE_ARN=
FACE_COLLECTION_PREFIX=attendex
# Separate export key; never reuse BIOMETRIC_KEY. Keep both out of source control.
BACKUP_KEY=

# Optional separate 64-hex mail queue key. Otherwise derived from BIOMETRIC_KEY.
ACCOUNT_MAIL_KEY=
