{
  "name": "attendex",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "node scripts/prepare-models.mjs && npm run build -w frontend",
    "start": "npm start -w backend",
    "test": "npm test -w backend",
    "test:unit": "npm run test:unit -w backend",
    "test:frontend": "npm test -w frontend",
    "prepare:models": "node scripts/prepare-models.mjs",
    "test:models": "node scripts/check-voice-model.mjs",
    "load:check": "node scripts/load-check.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=22"
  }
}
